# Kingdom Studio 环境变量示例
#
# 用法：把本文件复制成 .env（或在启动前设置同名环境变量），按本机情况填写。
# Spring Boot 不会自动读取 .env 文件，二选一：
#   1) 启动前导出：Windows PowerShell  ->  $env:DB_PASSWORD="你的密码"; cd backend; mvn spring-boot:run
#                  Git Bash / WSL      ->  export DB_PASSWORD=你的密码
#   2) 直接在启动参数里给：mvn spring-boot:run -Dspring-boot.run.arguments="--spring.datasource.password=你的密码"
#
# 标「必填」的项没有内置默认值：不提供就起不来，这是有意的——仓库里不留可用的默认密码与密钥。

# ---------- 数据库（必填：密码）----------
# 完整连接串，默认 jdbc:mysql://127.0.0.1:3306/kingdom_studio
DB_URL=jdbc:mysql://127.0.0.1:3306/kingdom_studio?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
# 必填：本地演示通常是 root，生产请用独立账号
DB_PASSWORD=

# ---------- Redis ----------
# 默认 127.0.0.1:6379、db 0、无密码
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------- 鉴权（必填：密钥）----------
# 当前版本接口未启用鉴权（SecurityConfig 全放行，仅本机演示）；
# 一旦接入 JWT 过滤器，这项必须提供，HS256 要求至少 32 字节的随机串。
JWT_SECRET=

# ---------- 跨域 ----------
# 逗号分隔。前端开发服务器默认 5173，本地开发无需修改
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- GitHub 采集（可选）----------
# 不设也能采集，只是限额低（未认证 10 次/分钟，认证后 30 次/分钟）。
# 触发限流时采集会立刻停止并在结果里说明原因，不会继续撞接口。
GITHUB_TOKEN=
